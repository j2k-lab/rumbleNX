<brls:AppletFrame
    iconInterpolation="linear"
    backgroundColor="@theme/brls/background"
    headerHidden="true"
    footerHidden="true">
    <brls:Box
        width="100%"
        height="100%"
        axis="column">
        <brls:Box
            id="hint/steps"
            width="100%"
            grow="1"
            axis="column"
            justifyContent="center"
            alignItems="center"
            paddingLeft="100"
            paddingRight="100">
            <brls:Label
                id="hint/title"
                focusable="true"
                hideHighlight="true"
                fontSize="32"
                marginBottom="20"
                horizontalAlign="center"
                text="You opened RumbleNX in applet mode" />
            <brls:Label
                id="hint/reason"
                fontSize="21"
                marginBottom="36"
                horizontalAlign="center"
                textColor="@theme/font/grey" />
            <brls:Label
                id="hint/howto"
                fontSize="24"
                marginBottom="16"
                text="To use RumbleNX, open it through a game instead:" />
            <brls:Label
                id="hint/step1"
                fontSize="22"
                marginBottom="12" />
            <brls:Label
                id="hint/step2"
                fontSize="22"
                marginBottom="12" />
            <brls:Label
                id="hint/step3"
                fontSize="22"
                marginBottom="12" />
        </brls:Box>
        <brls:Label
            id="hint/forwarder"
            fontSize="19"
            marginBottom="28"
            marginLeft="100"
            marginRight="100"
            horizontalAlign="center"
            textColor="@theme/font/grey" />
    </brls:Box>
</brls:AppletFrame>
