<brls:AppletFrame
    iconInterpolation="linear"
    backgroundColor="@theme/brls/background"
    headerHidden="true"
    footerHidden="true">
    <brls:Box
        id="hint/steps"
        width="100%"
        height="100%"
        axis="column"
        justifyContent="center"
        alignItems="center"
        paddingLeft="100"
        paddingRight="100">
        <brls:Label
            id="hint/title"
            focusable="true"
            hideHighlight="true"
            fontSize="32"
            marginBottom="40"
            horizontalAlign="center"
            text="Launch RumbleNX through a game" />
        <brls:Label
            id="hint/step1"
            fontSize="24"
            marginBottom="20" />
        <brls:Label
            id="hint/step2"
            fontSize="24"
            marginBottom="20" />
        <brls:Label
            id="hint/step3"
            fontSize="24"
            marginBottom="20" />
    </brls:Box>
</brls:AppletFrame>
